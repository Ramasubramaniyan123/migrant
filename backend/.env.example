DB_URL=jdbc:postgresql://localhost:5432/migrant_community
DB_USERNAME=postgres
DB_PASSWORD=postgress
DB_NAME=migrant_community

# JWT — generate a random secret of at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# First-boot admin (SUPER_ADMIN) credentials
ADMIN_BOOTSTRAP_EMAIL=superadmin@migrantcommunity.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# Public URL used in email links
APP_BASE_URL=http://localhost:5173

# SMTP — leave SPRING_MAIL_HOST empty to disable email delivery (logged, not sent)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
EMAIL_FROM=noreply@migrantcommunity.local
